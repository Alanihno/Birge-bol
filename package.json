{
  "name": "birge-bol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader native",
    "build": "tsc -b && vite build --configLoader native",
    "build:demo": "tsc -b && vite build --configLoader native --mode demo --outDir dist-demo",
    "package:demo": "npm run build:demo && node scripts/package-vercel-demo.cjs && node scripts/package-promt3.cjs",
    "preview": "vite preview --host 127.0.0.1 --configLoader native",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --configLoader native",
    "test:e2e": "npm run build:demo && playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.2",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/react-query": "5.105.0",
    "@radix-ui/react-dialog": "1.3.1",
    "leaflet": "1.9.4",
    "lucide-react": "0.575.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-router-dom": "7.13.1",
    "zod": "4.6.7",
    "@fontsource/inter": "5.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.1",
    "vite-plugin-pwa": "1.2.0",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
