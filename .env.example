# Public frontend settings (included in the browser build). Demo works without keys.
VITE_APP_MODE=demo
VITE_SUPABASE_URL=
# Publishable key is recommended. VITE_SUPABASE_ANON_KEY remains a legacy fallback.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_DEMO_ONLY=false
# Explicitly opt into existing synthetic test accounts, never on a real-data deployment.
VITE_ENABLE_DEMO_ACCOUNTS=false
VITE_VAPID_PUBLIC_KEY=
VITE_SITE_URL=https://birge-bol.vercel.app
VITE_LEGAL_OPERATOR=
VITE_PRIVACY_CONTACT=

# Server-only: configure in Supabase Edge Function secrets, never with VITE_ prefix.
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY are supplied by Supabase.
# ALLOWED_ORIGINS=https://birge-bol.vercel.app
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:replace-with-approved-contact
# PUSH_CRON_SECRET=
# AI_ENABLED=false
# GEMINI_API_KEY=       (unused by the dictionary/cache-only release)
# GEMINI_MODEL=         (unused by the dictionary/cache-only release)
# TRANSLATION_MODEL=    (external private-text translation disabled)
# Telegram configuration is intentionally outside this change at the user's request.

# Build/QA only, not browser settings.
# BIRGE_BUILD_ID=
# BASE_URL=http://127.0.0.1:4173
# CHROME_PATH=
# CONNECTED_AUTH_TESTS=0
